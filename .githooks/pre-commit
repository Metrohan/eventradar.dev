#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

run_check="$(
  awk -F= '$1 ~ /^[[:space:]]*RUN_CHECK_ON_PRE_COMMIT[[:space:]]*$/ {
    v=$2; gsub(/[[:space:]"]/, "", v); print tolower(v)
  }' .meto-ai/config 2>/dev/null | tail -1
)"

if [[ "$run_check" =~ ^(true|1|yes)$ ]]; then
  if command -v just >/dev/null 2>&1 && just --list 2>/dev/null | grep -qE '(^|[[:space:]])check([[:space:]]|$)'; then
    echo "[meto-ai] Running just check before commit..."
    just check
  else
    echo "[meto-ai] Pre-commit check enabled, but no usable 'just check' found." >&2
    exit 1
  fi
fi
