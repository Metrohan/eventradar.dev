POSTGRES_DB=event_scraper_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me

# Used by FastAPI backend container
DATABASE_URL=postgresql://app_user:change_me@db:5432/event_scraper_db
FLASK_SECRET_KEY=change_me_to_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Optional overrides
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://eventradar.dev
VITE_API_URL=http://localhost:8000

# Email (SMTP) — bkz. README "E-posta ve Tarayıcı Bildirimleri" (Resend önerilir)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=TechEventRadar <noreply@eventradar.dev>
# Öneri/şikayet formu gönderimlerinin e-postayla ileteceği adres (boşsa e-posta gitmez)
FEEDBACK_NOTIFY_EMAIL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=   # Kanal kullanıcı adı (@eventradar_tr) veya negatif sayısal ID

# Web Push (tarayıcı bildirimleri) — üretmek için: python scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Peers allowed to set X-Forwarded-For for rate limiting (uvicorn --forwarded-allow-ips).
# Production: host nginx -> 127.0.0.1:8000 reaches the backend via the docker gateway (e.g. 172.18.0.1).
# Set the exact gateway IP; the compose default is the whole docker private range 172.16.0.0/12.
# FORWARDED_ALLOW_IPS=172.18.0.1
